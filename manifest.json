{
  "manifest_version": 3,
  "name": "Universal Web Scraper",
  "version": "1.2.8",
  "version_name": "1.2.8 \u2014 long-hold poll keeps MV3 worker warm (fast task pickup)",
  "permissions": [
    "alarms",
    "scripting",
    "storage",
    "downloads",
    "activeTab",
    "webNavigation",
    "webRequest",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon.webp",
      "48": "icon.webp",
      "128": "icon.webp"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "contentExtractor.js",
        "screenshotCapture.js",
        "interactionExecutor.js"
      ]
    }
  ]
}